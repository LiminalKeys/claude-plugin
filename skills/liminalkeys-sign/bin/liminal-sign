#!/usr/bin/env bash
# Cached install wrapper — avoids pip install on every signing run in Claude sandboxes.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
WHEELS="${SKILL_DIR}/wheels"
VERSION="0.1.13"
WHEEL="${WHEELS}/liminalkeys_sign-${VERSION}-py3-none-any.whl"
CACHE_ROOT="${LIMINALKEYS_SIGN_CACHE:-${HOME}/.cache/liminalkeys-sign}"

_die() {
  echo "liminal-sign: $*" >&2
  echo "liminal-sign: Do not write pyHanko signing code — fix the bundled CLI or clear ${CACHE_ROOT}" >&2
  exit 127
}

if [[ ! -f "${WHEEL}" ]]; then
  _die "missing bundled wheel ${WHEEL} (plugin/skill out of date?)"
fi

WHEEL_SHA="$(sha256sum "${WHEEL}" | awk '{print $1}')"
CACHE_ID="${VERSION}-${WHEEL_SHA:0:16}"
VENV="${CACHE_ROOT}/venv-${CACHE_ID}"
SITE="${CACHE_ROOT}/site-${CACHE_ID}"
MARKER_VENV="${VENV}/.installed-version"
MARKER_SITE="${SITE}/.installed-version"
MARKER_BODY="${VERSION}
${WHEEL_SHA}"

_run_cli() {
  if [[ -n "${LIMINAL_SIGN_IN_RUN_CLI:-}" ]]; then
    echo "liminal-sign: recursion guard (use python3 -m liminalkeys_sign)" >&2
    exit 125
  fi
  export LIMINAL_SIGN_IN_RUN_CLI=1
  exec python3 -m liminalkeys_sign "$@"
}

_cache_hit_venv() {
  [[ -f "${MARKER_VENV}" ]] && [[ "$(cat "${MARKER_VENV}")" == "${MARKER_BODY}" ]]
}

_cache_hit_site() {
  [[ -f "${MARKER_SITE}" ]] && [[ "$(cat "${MARKER_SITE}")" == "${MARKER_BODY}" ]]
}

if _cache_hit_venv; then
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  _run_cli "$@"
fi

if _cache_hit_site; then
  export PYTHONPATH="${SITE}${PYTHONPATH:+:${PYTHONPATH}}"
  _run_cli "$@"
fi

if ! command -v python3 >/dev/null 2>&1; then
  _die "python3 not found"
fi

echo "liminal-sign: installing liminalkeys-sign==${VERSION} (wheel sha256 ${WHEEL_SHA:0:16}…)" >&2

_install_ok=false
if python3 -m venv "${VENV}" >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  if pip install --quiet --disable-pip-version-check \
    --no-index --find-links "${WHEELS}" \
    "liminalkeys-sign==${VERSION}"; then
    printf '%s\n' "${MARKER_BODY}" > "${MARKER_VENV}"
    _install_ok=true
    _run_cli "$@"
  fi
fi

if [[ "${_install_ok}" == false ]]; then
  rm -rf "${VENV}" 2>/dev/null || true
  mkdir -p "${SITE}"
  if ! pip install --quiet --disable-pip-version-check \
    --no-index --find-links "${WHEELS}" \
    --target "${SITE}" \
    "liminalkeys-sign==${VERSION}"; then
    _die "offline install failed (Python $(python3 -V 2>&1); need cp310+ with matching wheels in ${WHEELS})"
  fi
  printf '%s\n' "${MARKER_BODY}" > "${MARKER_SITE}"
  export PYTHONPATH="${SITE}${PYTHONPATH:+:${PYTHONPATH}}"
  _run_cli "$@"
fi