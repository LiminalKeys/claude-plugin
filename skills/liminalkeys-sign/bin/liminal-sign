#!/usr/bin/env bash
# Cached install wrapper — avoids pip install on every signing run in Claude sandboxes.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
WHEELS="${SKILL_DIR}/wheels"
VERSION="0.1.10"
CACHE_ROOT="${LIMINALKEYS_SIGN_CACHE:-${HOME}/.cache/liminalkeys-sign}"
VENV="${CACHE_ROOT}/venv-${VERSION}"
SITE="${CACHE_ROOT}/site-${VERSION}"
MARKER_VENV="${VENV}/.installed-version"
MARKER_SITE="${SITE}/.installed-version"

_run_cli() {
  if command -v liminal-sign >/dev/null 2>&1; then
    exec liminal-sign "$@"
  fi
  if command -v liminalkeys-sign >/dev/null 2>&1; then
    exec liminalkeys-sign "$@"
  fi
  exec python3 -m liminalkeys_sign "$@"
}

if [[ -f "${MARKER_VENV}" ]] && [[ "$(cat "${MARKER_VENV}")" == "${VERSION}" ]]; then
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  _run_cli "$@"
fi

if [[ -f "${MARKER_SITE}" ]] && [[ "$(cat "${MARKER_SITE}")" == "${VERSION}" ]]; then
  export PYTHONPATH="${SITE}${PYTHONPATH:+:${PYTHONPATH}}"
  _run_cli "$@"
fi

if python3 -m venv "${VENV}" >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  pip install --quiet --disable-pip-version-check \
    --no-index --find-links "${WHEELS}" \
    "liminalkeys-sign==${VERSION}"
  echo "${VERSION}" > "${MARKER_VENV}"
  _run_cli "$@"
fi

mkdir -p "${SITE}"
pip install --quiet --disable-pip-version-check \
  --no-index --find-links "${WHEELS}" \
  --target "${SITE}" \
  "liminalkeys-sign==${VERSION}"
echo "${VERSION}" > "${MARKER_SITE}"
export PYTHONPATH="${SITE}${PYTHONPATH:+:${PYTHONPATH}}"
_run_cli "$@"